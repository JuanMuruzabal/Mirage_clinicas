# Variables opcionales para `docker compose up` (raíz del monorepo).
# Copiar a `.env` y ajustar si hace falta — las dos tienen un default
# razonable para desarrollo local en docker-compose.yml, así que este
# archivo es solo para overridear algo puntual.
#
# Nota: esto es aparte de apps/api/.env.example y apps/web/.env.example,
# que se usan para correr cada app suelta con `pnpm run dev:api`/`dev:web`
# fuera de Docker (ver README.md).

JWT_SECRET=dev-secret-cambiar-en-produccion
CONTACTO_EMAIL=hola@dentalmirage.com.ar

# Login con Google / CAPTCHA de Turnstile (opcional, nil-safe sin
# configurar) — solo el client ID/site key PÚBLICOS, nunca un secreto
# (el client secret de Google va en apps/api/.env.example, del lado del
# server). Se usan como build-arg de apps/web/Dockerfile, no como env
# var de runtime — ver docker-compose.yml.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

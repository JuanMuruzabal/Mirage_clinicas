{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "fotoUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^$|^\\/uploads\\/|^https:\\/\\/|^http:\\/\\/"
    },
    "subtipo": {
      "type": "string",
      "enum": [
        "retrato",
        "banner",
        "franja"
      ]
    }
  },
  "required": [
    "subtipo"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

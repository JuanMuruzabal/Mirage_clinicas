{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "efectos": {
      "type": "object",
      "properties": {
        "imagen": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "inclinacion",
                "reflejo",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fotoUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^$|^\\/uploads\\/|^https:\\/\\/|^http:\\/\\/"
    },
    "subtipo": {
      "type": "string",
      "enum": [
        "retrato",
        "banner",
        "franja"
      ]
    }
  },
  "required": [
    "subtipo"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

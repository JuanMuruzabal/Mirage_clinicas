{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "variante": {
      "type": "string",
      "enum": [
        "grilla",
        "mosaico",
        "carrusel"
      ]
    },
    "efectos": {
      "type": "object",
      "properties": {
        "tarjeta": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "inclinacion",
                "foco-cursor",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        },
        "imagen": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "inclinacion",
                "reflejo",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fotoUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^$|^\\/uploads\\/|^https:\\/\\/|^http:\\/\\/"
      },
      "maxItems": 8
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "variante": {
      "type": "string",
      "enum": [
        "semanal",
        "compacto",
        "contacto",
        "abierto-ahora"
      ]
    },
    "efectos": {
      "type": "object",
      "properties": {
        "tarjeta": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "inclinacion",
                "foco-cursor",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        },
        "titulo": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "brillo-texto",
                "degrade-texto",
                "frases-rotativas",
                "palabras",
                "subrayado",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        },
        "texto": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "aparicion-suave",
                "deslizar-suave",
                "revelado-scroll",
                "brillo-texto",
                "degrade-texto",
                "frases-rotativas",
                "palabras",
                "subrayado",
                "ninguno"
              ]
            },
            "intensidad": {
              "type": "string",
              "enum": [
                "sutil",
                "media",
                "marcada"
              ]
            }
          },
          "required": [
            "id",
            "intensidad"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

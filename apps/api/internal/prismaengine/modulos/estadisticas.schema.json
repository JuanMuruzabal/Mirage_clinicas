{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "variante": {
      "type": "string",
      "enum": [
        "tarjetas",
        "franja"
      ]
    },
    "mostrar": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pacientes_atendidos",
          "turnos_realizados"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

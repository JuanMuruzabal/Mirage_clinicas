{
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 60
    },
    "tituloPublico": {
      "type": "string",
      "maxLength": 80
    },
    "fondoSeccion": {
      "type": "string",
      "enum": [
        "normal",
        "acento",
        "contraste"
      ]
    },
    "alineacion": {
      "type": "string",
      "enum": [
        "centro",
        "izquierda"
      ]
    },
    "variante": {
      "type": "string",
      "enum": [
        "centrado",
        "con-foto",
        "dos-columnas"
      ]
    },
    "fotoUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^$|^\\/uploads\\/|^https:\\/\\/|^http:\\/\\/"
    },
    "titulo": {
      "type": "string",
      "maxLength": 80
    },
    "texto": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}

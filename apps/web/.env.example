# Copiar a .env.local (mismo directorio) para desarrollo local. Ninguno de
# estos valores es un secret real — los dos tienen default seguro en el
# código si no se define nada (ver lib/api.ts / lib/contacto.ts), así que
# este archivo es opcional salvo que quieras pisar alguno de los defaults.

# URL del backend Go (apps/api) — server-only, nunca expuesta al browser
# (spec §9.3, BFF sin excepciones). Default: http://localhost:8080.
API_URL=http://localhost:8080

# Secreto compartido con apps/api (Fase 3.1.1). El navegador nunca llama a
# la API directo, así que del otro lado llega siempre la IP de ESTE proceso
# — la misma para todos los visitantes, lo que dejaba al rate-limiting por
# IP y a los detectores de abuso del wizard contando a todo el mundo como
# una sola persona. Con este secreto, lib/api.ts adjunta la IP real del
# visitante y la API le cree. Tiene que ser EL MISMO valor que el de
# apps/api/.env; vacío = no se manda nada y todo funciona como antes.
BFF_SHARED_SECRET=dev-bff-secret

# Email de contacto que se muestra en el footer público. Sin dato real del
# cliente todavía — default: hola@dentalmirage.com.ar.
CONTACTO_EMAIL=hola@dentalmirage.com.ar

# --- Auth/onboarding (docs/Login/feature-sumarte-login.md) ---
# Client ID de OAuth de Google (tipo "Web application", Google Cloud
# Console) — NO es un secreto, viaja al navegador para armar el botón de
# Google (el client secret vive solo en apps/api). Sin configurar, el
# botón de Google directamente no se renderiza.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Site key pública de Cloudflare Turnstile — sin configurar, el widget de
# CAPTCHA no se renderiza (mismo criterio nil-disabled que el backend sin
# TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
